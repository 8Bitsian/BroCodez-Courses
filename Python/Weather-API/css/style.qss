QMainWindow {
    background-color: white;
}

QLabel {
    font-family: Barlow Semi 
    Condensed;
    color: blue;
    padding: 0px;
    margin: 0px;
}

QLabel#title {
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 2px;
}

QLabel#temperature {
    font-size: 48px;
    font-weight: bold;
}

QLabel#caption {
    font-size: 24px;
    font-weight: regular;
    letter-spacing: 2px;
}

QLineEdit {
    font-family: Barlow Semi 
    Condensed;
    font-size: 12px;
    font-weight: semibold;
    padding: 0px;
    margin: 0px;
    border: 2px solid blue;
    border-raidus: 5px;
    color: blue;
}

QPushButton {
    font-family: Barlow Semi 
    Condensed;
    font-size: 14px;
    font-weight: semibold;
    padding: 8px 10px;
    margin: 0px;
    border: 2px solid blue;
    border-radius: 5px;
    color: blue;
}

QPushButton:hover {
    background-color: darkblue;
    color: white;
}