QMainWindow {
    background-color: black;
}

QLabel{
    font-family: Jetbrains Mono;
    padding: 3px 3px;
    margin: 3px;
    border: 3px solid limegreen;
    border-radius: 5px;
    color: limegreen;
}

QLabel#title {
    font-size: 25px;
    font-weight: extra-bold;
    letter-spacing: 4px;
}

QLabel#time {
    font-size: 60px;
}